module zip_test;
import zip, std::core::test;

// Archives made with Python's zipfile: a ROM stored as it is, deflated with
// the fixed codes (after a file that isn't a ROM), deflated with codes of its
// own, and an archive with no ROM. Python's zip, Info-ZIP, 7-Zip, bsdtar and
// the streams in Gradle's and Go's archives were also checked this way.

fn char[] hello() {
	DString s;
	s.tinit();
	for (int i = 0; i < 3; i++) s.append("Hello, Game Boy! ");
	return s.str_view();
}

fn char[] lines() {
	DString s;
	s.tinit();
	for (int i = 0; i < 120; i++) s.appendf("Line %d of the Game Boy's ROM; ", i);
	return s.str_view();
}

fn void stored_and_fixed() @test {
	test::eq(zip::is_zip(&STORED), true);
	test::eq(zip::extract_rom(&STORED, tmem)!!, hello());
	test::eq(zip::extract_rom(&FIXED, tmem)!!, hello());
}

fn void dynamic_codes() @test {
	test::eq(zip::extract_rom(&DYNAMIC, tmem)!!, lines());
}

fn void mistakes() @test {
	test::eq(@catch(zip::extract_rom(&NO_ROM, tmem)), zip::NO_ROM);
	test::eq(@catch(zip::extract_rom("not a zip at all, really", tmem)), zip::NOT_A_ZIP);
	char[*] damaged = DYNAMIC;
	damaged[60] ^= 0x10;                      // inside the deflated data
	test::eq(@ok(zip::extract_rom(&damaged, tmem)), false);
	test::eq(zip::is_zip("PK\x01\x02"), false);
}

