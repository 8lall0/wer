# Copy to keystore.properties (never committed: .gitignore) to sign release
# builds with your Google Play upload key (scripts/build-android.sh release).
# Make the key with:
#   keytool -genkeypair -v -keystore ~/.android/wer-upload.jks -alias upload \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=~/.android/wer-upload.jks
storePassword=the keystore's password
keyAlias=upload
keyPassword=the key's password (the same, unless you gave it its own)
