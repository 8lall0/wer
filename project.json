{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  // Libraries to use for all targets.
  "dependencies": [ ],
  // Authors, optionally with email.
  "authors": [ "Savino Liguori aka 8lall0" ],
  // Version using semantic versioning.
  "version": "0.23.0",
  // Sources compiled for all targets.
  "sources": [ "src/**" ],
  // Test sources compiled for all targets.
  "test-sources": [ "test/**" ],
  // C sources if the project also compiles C sources
  // relative to the project file.
  // "c-sources": [ "csource/**" ],
  // Include directories for C sources relative to the project file.
  // "c-include-dirs": [ "csource/include" ],
  // Build location, relative to project file.
  "build-dir": "build",
  // Output location, relative to project file.
  "output": "build",
  // Directory where exec scripts are looked up.
  "script-dir": ".",
  // Architecture and OS target.
  // You can use 'c3c --list-targets' to list all valid targets.
  // "target": "windows-x64",
  // Targets.
  "targets": {
    "wer": {
      "type": "executable",
      // SDL3 (system library) is used by src/frontend/display.c3 for the window,
      // renderer and audio. Only the executable links it; `c3c test` does not.
      "linked-libraries": [ "SDL3" ],
    },
    "windows": {
      "name": "wer",
      "type": "executable",
      "target": "windows-x64",
      // A GUI program (no console window), with the C runtime linked in (no
      // VCRUNTIME140.dll needed), and build/wer.res: icon, manifest and
      // version information (scripts/build-windows-res.sh).
      "win-subsystem": "windows",
      "wincrt": "static",
      // SDL's own Windows build: links its import library, and SDL3.dll has
      // to sit next to wer.exe (scripts/build-sdl3.sh windows fetches both).
      "exec": [ "./scripts/build-sdl3.sh windows", "./scripts/build-windows-res.sh" ],
      "linker-search-paths": [
        "deps/sdl3-windows/lib"
      ],
      "linked-libraries": [ "SDL3" ],
      "link-args": [ "build/wer.res" ],
    },
    "web": {
      // WebAssembly for browsers (Emscripten: emcc on the PATH, e.g. from
      // ~/emsdk/emsdk_env.sh), with Emscripten's own SDL3 port.
      // scripts/build-web.sh makes build/web/ (page, .js, .wasm).
      "name": "wer",
      "type": "executable",
      "target": "emscripten",
      "link-args": [
        "--use-port=sdl3",
        // Binaryen optimises the whole module at link time.
        "-O3",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sSTACK_SIZE=1048576",
        // The page (web/index.html) hands chosen ROMs to wer_rom_chosen.
        "-sEXPORTED_FUNCTIONS=_main,_wer_rom_chosen,_wer_frames,_wer_save,_wer_longest_work,_wer_longest_gap,_wer_touch,_wer_motion,_wer_net_open,_wer_net_closed,_wer_net_packet,_wer_net_join_code,_wer_cheat_add,_wer_barcode_swipe",
        "-sEXPORTED_RUNTIME_METHODS=ccall,FS",
        // Saves and settings kept in the browser (IndexedDB).
        "-lidbfs.js"
      ],
    },
    "android": {
      // libmain.so for SDL's Android activity (android/, built into an APK
      // by scripts/build-android.sh), arm64 only. SDL is a shared
      // libSDL3.so next to it (scripts/build-sdl3.sh android).
      "name": "main",
      "type": "dynamic-lib",
      "target": "android-aarch64",
      "android-ndk": "/opt/android-sdk/ndk/30.0.16248370",
      "android-api": 24,
      "exec": [ "./scripts/build-sdl3.sh android" ],
      "linker-search-paths": [
        "deps/sdl3-android-arm64/lib"
      ],
      "linked-libraries": [ "SDL3" ],
    },
    "macos": {
      "name": "wer_macos",
      "type": "executable",
      "target": "macos-aarch64",
      "exec": [ "./scripts/build-sdl3.sh macos" ],
      "cc": "clang",
      "cflags": "--target=arm64-apple-macos11.0 -isysroot deps/MacOSX.sdk",
      "linker-search-paths": [
        "deps/sdl3-macos-aarch64/lib"
      ],
      "linked-libraries": [ "SDL3" ],
      "link-args": [
        // __isPlatformVersionAtLeast is emitted by clang for ObjC @available() checks
        // in SDL3's static lib. It lives in macOS libSystem at runtime; -U lets
        // ld64.lld leave it undefined so the OS resolves it correctly on the target.
        "-U", "___isPlatformVersionAtLeast",
        // The Info.plist macOS asks for before a program may use the camera.
        "-sectcreate", "__TEXT", "__info_plist", "resources/macos/Info.plist",
        "-framework", "Cocoa",
        "-framework", "IOKit",
        "-framework", "CoreAudio",
        "-framework", "AudioToolbox",
        "-framework", "CoreVideo",
        "-framework", "CoreMedia",
        "-framework", "AVFoundation",
        "-framework", "UserNotifications",
        "-framework", "Metal",
        "-framework", "QuartzCore",
        "-framework", "Security",
        "-framework", "Carbon",
        "-framework", "ForceFeedback",
        "-framework", "GameController",
        "-framework", "CoreHaptics",
        "-framework", "UniformTypeIdentifiers"
      ]
    }
  },
  // Global settings.
  // CPU name, used for optimizations in the LLVM backend.
  "cpu": "generic",
  // Optimization: "O0", "O1", "O2", "O3", "O4", "O5", "Os", "Oz".
  "opt": "O0"
  // See resources/examples/project_all_settings.json and 'c3c --list-project-properties' to see more properties.
}