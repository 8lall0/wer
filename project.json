{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  // Libraries to use for all targets.
  "dependencies": [ ],
  // Authors, optionally with email.
  "authors": [ "Savino Liguori aka 8lall0" ],
  // Version using semantic versioning.
  "version": "0.7.4",
  // Sources compiled for all targets.
  "sources": [ "src/**" ],
  // Test sources compiled for all targets.
  "test-sources": [ "test/**" ],
  // C sources if the project also compiles C sources
  // relative to the project file.
  // "c-sources": [ "csource/**" ],
  // Include directories for C sources relative to the project file.
  // "c-include-dirs": [ "csource/include" ],
  // Build location, relative to project file.
  "build-dir": "build",
  // Output location, relative to project file.
  "output": "build",
  // Directory where exec scripts are looked up.
  "script-dir": ".",
  // Architecture and OS target.
  // You can use 'c3c --list-targets' to list all valid targets.
  // "target": "windows-x64",
  // Targets.
  "targets": {
    "wer": {
      "type": "executable",
      // SDL3 (system library) is used by src/display.c3 for the window,
      // renderer and audio. Only the executable links it; `c3c test` does not.
      "linked-libraries": [ "SDL3" ],
    },
    "macos": {
      "name": "wer_macos",
      "type": "executable",
      "target": "macos-aarch64",
      "exec": [ "./scripts/build-sdl3.sh macos" ],
      "cc": "clang",
      "cflags": "--target=arm64-apple-macos11.0 -isysroot deps/MacOSX.sdk",
      "linker-search-paths": [
        "deps/sdl3-macos-aarch64/lib"
      ],
      "linked-libraries": [ "SDL3" ],
      "link-args": [
        // __isPlatformVersionAtLeast is emitted by clang for ObjC @available() checks
        // in SDL3's static lib. It lives in macOS libSystem at runtime; -U lets
        // ld64.lld leave it undefined so the OS resolves it correctly on the target.
        "-U", "___isPlatformVersionAtLeast",
        "-framework", "Cocoa",
        "-framework", "IOKit",
        "-framework", "CoreAudio",
        "-framework", "AudioToolbox",
        "-framework", "CoreVideo",
        "-framework", "CoreMedia",
        "-framework", "AVFoundation",
        "-framework", "UserNotifications",
        "-framework", "Metal",
        "-framework", "QuartzCore",
        "-framework", "Security",
        "-framework", "Carbon",
        "-framework", "ForceFeedback",
        "-framework", "GameController",
        "-framework", "CoreHaptics",
        "-framework", "UniformTypeIdentifiers"
      ]
    }
  },
  // Global settings.
  // CPU name, used for optimizations in the LLVM backend.
  "cpu": "generic",
  // Optimization: "O0", "O1", "O2", "O3", "O4", "O5", "Os", "Oz".
  "opt": "O0"
  // See resources/examples/project_all_settings.json and 'c3c --list-project-properties' to see more properties.
}