module icon;

// wer's program icon, 32x32 pixels: one character per pixel, indexing
// COLOURS ('.' is transparent). Generated by scripts/make-icon.py, which
// also writes resources/wer.svg.

const int SIZE = 32;

const String KEYS = "BCGKMOPRTWYgs";
const uint[13] COLOURS = { // 0xRRGGBB
	0x000080, 0x00FFFF, 0x008000, 0x000000, 0x800000, 0x808000, 0xFF00FF, 0xFF0000, 0x008080, 0xFFFFFF, 0xFFFF00, 0x808080, 0xC0C0C0,
};

const String[32] PIXELS = {
	".........RRRRRRM................",
	"........RRPgPRRRRRM.............",
	"........RRPCCPPRRRRRM...........",
	"........RRPCCCCPPPRRRRRM........",
	".......RRPCCCCCCCCPPRRRRM.......",
	".......RRPCCCCCCCCCCPgPRM.......",
	"......RRPPCCCCCCCCCCCPRRM.......",
	"......RRPCCCCCCCCCCCCPRM........",
	".....RRRPCCCCCCCCCCCPPRM........",
	".....RRPCCCCCCCCCCCCPRM.........",
	".....RRPPCCCCCCCCCCCPRM.........",
	"....RRRRPPPCCCCCCCCPRRM.........",
	"....RRRRRRRPPPCCCCCPRM..........",
	"...RRRRRRRRRRPPPCCPPRM..........",
	"...RRRRKRRRRRRRRPPPRM...........",
	"...RRRRKRRRRRRRRRRPRM...........",
	"..RRRKKKKKRRRRRRRRRRM...........",
	"..RRRRRKRRRRRRRRRRRM............",
	".RRRRRRKRRRRRRMMRRRM............",
	".RRRRRRRRRRMMMMMRRM.............",
	".MRRRRRRKKKKKKKKKKKKKKKKKKKK....",
	"..MMRRRKGGGGGKKKKKKGGGGGGGGGKK..",
	"...KKKKGGKKKKKWYYYKKKKKKKKGGGGK.",
	"...KWYKGGKWYKWYKKYYKWYKWYKKGGGGK",
	"...KYYKKKKYYKYYYYYKKYYYYYYKGGGGK",
	"...KYYKWYKYYKYYKKKKKYYYKKKKGGGGK",
	"...KYYKYYKYYKYYKKKYKYYKKGGGGGGGK",
	"...KYYYYYYYYKKYYYYKKYYKGGGKKKKGK",
	"...KKYYKKYYKKKKKKKKKYYKGGGKWYKK.",
	"....KKKKKKKKGGGGGGGKKKKGGGKYYK..",
	"........KKKKKKGGGGGGGGGKKKKKKK..",
	"..............KKKKKKKKK.........",
};

// The icon as RGBA bytes, each pixel `scale` x `scale`: out holds
// (SIZE * scale)^2 * 4 bytes.
fn void rgba(char[] out, int scale) {
	int w = SIZE * scale;
	for (int y = 0; y < w; y++) {
		for (int x = 0; x < w; x++) {
			char k = PIXELS[y / scale][x / scale];
			usz i = (usz)(y * w + x) * 4;
			sz? c = KEYS.index_of_char(k);
			uint rgb = @ok(c) ? COLOURS[c!!] : 0;
			out[i]     = (char)(rgb >> 16);
			out[i + 1] = (char)(rgb >> 8);
			out[i + 2] = (char)rgb;
			out[i + 3] = @ok(c) ? 0xFF : 0;
		}
	}
}
